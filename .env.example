# Copiá este archivo a .env y reemplazá los valores. .env NO se commitea.

# Contraseña del usuario sa de SQL Server: 8+ caracteres con mayúsculas, minúsculas y números.
# Sin ';' ni comillas (va dentro de la cadena de conexión).
MSSQL_SA_PASSWORD=CambiarEsto-Sql2026

# Clave de firma de los JWT: al menos 32 bytes aleatorios. En PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SIGNING_KEY=

# Comercio operador de la plataforma (HS Tech) y su primer administrador: emite las invitaciones.
PLATAFORMA_SLUG=hs-tech
PLATAFORMA_ADMIN_USUARIO=hs-admin
# 12+ caracteres, con letras y números. Solo se usa para crear el administrador la primera vez.
PLATAFORMA_ADMIN_PASSWORD=
