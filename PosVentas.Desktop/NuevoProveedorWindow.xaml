<Window x:Class="PosVentas.Desktop.NuevoProveedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Formulario de Proveedor" Height="520" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8F9FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="LblTitulo" Text="Nuevo Proveedor" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,5">
                    <TextBlock Text="Datos Identificatorios y Fiscales" FontWeight="Bold" Foreground="#2980B9"/>
                </Border>

                <TextBlock Text="Razón Social / Empresa *" Margin="0,5,0,2" Foreground="#333333"/>
                <TextBox Name="TxtRazonSocial" Height="30" VerticalContentAlignment="Center" MaxLength="150"/>

                <TextBlock Text="CUIT" Margin="0,10,0,2" Foreground="#333333"/>
                <TextBox Name="TxtCuit" Height="30" VerticalContentAlignment="Center" MaxLength="20"/>

                <TextBlock Text="Responsabilidad ante el IVA" Margin="0,10,0,2" Foreground="#333333"/>
                <ComboBox Name="CboIva" Height="30" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Responsable Inscripto" IsSelected="True"/>
                    <ComboBoxItem Content="Monotributo"/>
                    <ComboBoxItem Content="Exento"/>
                </ComboBox>

                <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Margin="0,20,0,10" Padding="0,0,0,5">
                    <TextBlock Text="Datos de Contacto y Atención" FontWeight="Bold" Foreground="#2980B9"/>
                </Border>

                <TextBlock Text="Nombre del Preventista / Viajante" Margin="0,5,0,2" Foreground="#333333"/>
                <TextBox Name="TxtNombreContacto" Height="30" VerticalContentAlignment="Center" MaxLength="100"/>

                <TextBlock Text="Teléfono" Margin="0,10,0,2" Foreground="#333333"/>
                <TextBox Name="TxtTelefono" Height="30" VerticalContentAlignment="Center" MaxLength="50"/>

                <TextBlock Text="Email" Margin="0,10,0,2" Foreground="#333333"/>
                <TextBox Name="TxtEmail" Height="30" VerticalContentAlignment="Center" MaxLength="100"/>

                <TextBlock Text="Dirección Comercial" Margin="0,10,0,2" Foreground="#333333"/>
                <TextBox Name="TxtDireccion" Height="30" VerticalContentAlignment="Center" MaxLength="250"/>

                <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Margin="0,20,0,10" Padding="0,0,0,5">
                    <TextBlock Text="Condiciones de Compra" FontWeight="Bold" Foreground="#2980B9"/>
                </Border>

                <CheckBox Name="ChkPermiteCtaCte" Content="Operamos a Crédito / Cuenta Corriente Pasiva" Margin="0,5,0,5" VerticalAlignment="Center" Checked="ChkPermiteCtaCte_Checked" Unchecked="ChkPermiteCtaCte_Unchecked"/>

                <TextBlock Text="Plazo de Pago Estándar (Días)" Margin="0,5,0,2" Foreground="#333333"/>
                <TextBox Name="TxtDiasPlazo" Height="30" VerticalContentAlignment="Center" Text="0" IsEnabled="False" HorizontalContentAlignment="Right"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnCancelar" Content="Cancelar" Width="90" Height="32" Margin="5,0" Background="#95A5A6" Foreground="White" BorderThickness="0" Click="BtnCancelar_Click"/>
            <Button Name="BtnGuardar" Content="Guardar" Width="90" Height="32" Margin="5,0" Background="#2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>