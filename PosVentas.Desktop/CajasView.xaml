<UserControl x:Class="PosVentas.Desktop.CajasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosVentas.Desktop" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="White" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="💻 Control de Cajas y Turnos Diarios" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Monitoree las terminales abiertas, inicie nuevos turnos de facturación o realice arqueos de cierre." FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Name="GridCajas" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="#F8F9FA" RowBackground="White" AlternatingRowBackground="#F1F2F6" 
                  GridLinesVisibility="None" BorderThickness="1" BorderBrush="#BDC3C7"
                  SelectionChanged="GridCajas_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Terminal / Caja" Binding="{Binding Nombre}" Width="180" FontWeight="Bold"/>
                <DataGridTextColumn Header="Equipo Red" Binding="{Binding ComputadoraAsignada}" Width="130"/>

                <DataGridTextColumn Header="¿Está Abierta?" Binding="{Binding EstaAbierta}" Width="120"/>

                <DataGridTextColumn Header="Cajero Activo" Binding="{Binding CajeroActual}" Width="150"/>
                <DataGridTextColumn Header="Fondo Inicial" Binding="{Binding MontoApertura, StringFormat={}{0:C}}" Width="120"/>
                <DataGridTextColumn Header="Apertura" Binding="{Binding FechaApertura, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="BtnAbrirCaja" Content="🔑 Abrir Turno" Width="130" Height="38" Margin="5,0" Background="#2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnAbrirCaja_Click"/>
            <Button Name="BtnCerrarCaja" Content="🔒 Arqueo / Cierre" Width="130" Height="38" Margin="5,0" Background="#E74C3C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnCerrarCaja_Click"/>
        </StackPanel>
    </Grid>
</UserControl>