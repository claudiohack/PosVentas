
<Window x:Class="PosVentas.Desktop.NuevoProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Nuevo Producto" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📦 Nuevo Producto" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Código (SKU):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Name="TxtSku" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Nombre/Desc.:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Name="TxtNombre" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Precio Venta:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Name="TxtPrecio" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Porcentaje IVA:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox Name="CboIva" Grid.Column="1" Height="30" VerticalContentAlignment="Center" SelectedIndex="1">
                    <ComboBoxItem Content="0 %"/>
                    <ComboBoxItem Content="21 %"/>
                    <ComboBoxItem Content="10.5 %"/>
                </ComboBox>
            </Grid>

            <CheckBox Name="ChkSinStock" Content="Permitir vender sin stock" Margin="120,10,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Name="BtnGuardar" Content="💾 Guardar" Width="100" Height="35" Margin="5,0" Background="#2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnGuardar_Click"/>
            <Button Name="BtnCancelar" Content="❌ Cancelar" Width="100" Height="35" Margin="5,0" Background="#95A5A6" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>