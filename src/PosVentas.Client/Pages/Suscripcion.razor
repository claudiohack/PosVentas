@page "/suscripcion"
@inject PosVentasApi Api
@inject SesionService Sesion
@inject NavigationManager Navegacion

<PageTitle>Mi suscripción · PosVentas</PageTitle>

<h1>Mi suscripción</h1>

@if (error is not null)
{
    <p class="error" role="alert">@error</p>
}

@if (datos is null)
{
    @if (error is null)
    {
        <section class="tarjeta"><p>Cargando…</p></section>
    }
}
else
{
    var r = datos.Resumen;
    <section class="tarjeta resumen-suscripcion">
        <div>
            <span class="etiqueta">Plan</span>
            <strong class="dato-grande">@datos.Plan.Nombre</strong>
            <span class="ayuda">@TextosSuscripcion.Pesos(datos.Plan.PrecioMensual) por mes</span>
        </div>
        <div>
            <span class="etiqueta">Estado</span>
            <span class="badge @TextosSuscripcion.Clase(r.Estado)">@TextosSuscripcion.Estado(r.Estado)</span>
            <span class="ayuda">@Vencimiento(r)</span>
        </div>
        <div>
            <span class="etiqueta">Usuarios activos</span>
            <strong>@datos.UsuariosActivos <small>de @TextosSuscripcion.Limite(datos.Plan.MaxUsuarios)</small></strong>
            <Uso Actual="datos.UsuariosActivos" Maximo="datos.Plan.MaxUsuarios" />
        </div>
        <div>
            <span class="etiqueta">Productos activos</span>
            <strong>@datos.ProductosActivos.ToString("N0") <small>de @TextosSuscripcion.Limite(datos.Plan.MaxProductos)</small></strong>
            <Uso Actual="datos.ProductosActivos" Maximo="datos.Plan.MaxProductos" />
        </div>
    </section>

    @if (volvioDeMercadoPago)
    {
        <p class="aviso" role="status">
            Si autorizaste el pago en Mercado Pago, en unos instantes se confirma acá (Mercado Pago nos avisa solo).
            <button class="btn-link" @onclick="RecargarAsync">Actualizar</button>
        </p>
    }

    @if (datos.DebitoAutomatico is { } debito)
    {
        <section class="tarjeta fila-debito">
            <div>
                <strong>Débito automático con Mercado Pago:</strong>
                <span class="badge @(debito == EstadoDebitoAutomatico.Activo ? "activo" : debito == EstadoDebitoAutomatico.Pausado ? "susc-gracia" : "baja")">
                    @(debito switch { EstadoDebitoAutomatico.Activo => "Activo", EstadoDebitoAutomatico.Pausado => "Pausado", _ => "Cancelado" })
                </span>
                <p class="ayuda">
                    @(debito == EstadoDebitoAutomatico.Activo
                        ? $"Mercado Pago te cobra {TextosSuscripcion.Pesos(datos.Plan.PrecioMensual)} por mes y la suscripción se renueva sola."
                        : "No hay cobros automáticos: el servicio sigue hasta el vencimiento ya pagado. Podés volver a suscribirte cuando quieras.")
                </p>
            </div>
            @if (debito != EstadoDebitoAutomatico.Cancelado && Sesion.EsAdministrador)
            {
                @if (confirmandoCancelacion)
                {
                    <span class="acciones">
                        <button class="btn-secundario" disabled="@procesando" @onclick="() => confirmandoCancelacion = false">No</button>
                        <button class="btn-peligro" disabled="@procesando" @onclick="CancelarDebitoAsync">Sí, cancelar el débito</button>
                    </span>
                }
                else
                {
                    <button class="btn-secundario" @onclick="() => confirmandoCancelacion = true">Cancelar débito automático</button>
                }
            }
        </section>
    }

    <section class="tarjeta">
        <h2>Planes</h2>
        @if (datos.MercadoPagoHabilitado && Sesion.EsAdministrador)
        {
            <p class="ayuda">
                Elegí un plan y suscribite con Mercado Pago: autorizás tu tarjeta una vez y se cobra solo cada mes.
                Si ya tenés un débito, el nuevo reemplaza al anterior.
            </p>
            <label class="campo-email-mp">
                Email de tu cuenta de Mercado Pago
                <input type="email" @bind="emailPagador" @bind:event="oninput" placeholder="tu-email@ejemplo.com" maxlength="150" />
            </label>
        }
        else
        {
            <p class="ayuda">
                @(Sesion.EsAdministrador
                    ? "El pago con Mercado Pago no está disponible por ahora. Para cambiar de plan o abonar tu suscripción, contactá a HS Tech."
                    : "Para cambiar de plan o abonar la suscripción, hablá con el Administrador de tu comercio.")
            </p>
        }
        <div class="tabla-scroll">
            <table class="comparativa-planes">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var p in datos.PlanesDisponibles)
                        {
                            <th class="@(p.Id == datos.Plan.Id ? "plan-actual" : null)">
                                @p.Nombre
                                @if (p.Id == datos.Plan.Id)
                                {
                                    <span class="badge activo">Tu plan</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Precio mensual</th>
                        @foreach (var p in datos.PlanesDisponibles)
                        {
                            <td class="@(p.Id == datos.Plan.Id ? "plan-actual" : null)"><strong>@TextosSuscripcion.Pesos(p.PrecioMensual)</strong></td>
                        }
                    </tr>
                    <tr>
                        <th>Usuarios</th>
                        @foreach (var p in datos.PlanesDisponibles)
                        {
                            <td class="@(p.Id == datos.Plan.Id ? "plan-actual" : null)">@TextosSuscripcion.Limite(p.MaxUsuarios)</td>
                        }
                    </tr>
                    <tr>
                        <th>Productos</th>
                        @foreach (var p in datos.PlanesDisponibles)
                        {
                            <td class="@(p.Id == datos.Plan.Id ? "plan-actual" : null)">@TextosSuscripcion.Limite(p.MaxProductos)</td>
                        }
                    </tr>
                    <tr>
                        <th>Ventas, caja, clientes y cuenta corriente</th>
                        @foreach (var p in datos.PlanesDisponibles)
                        {
                            <td class="@(p.Id == datos.Plan.Id ? "plan-actual" : null)">✓</td>
                        }
                    </tr>
                    @foreach (var m in datos.Modulos)
                    {
                        <tr>
                            <th title="@m.Descripcion">@m.Nombre</th>
                            @foreach (var p in datos.PlanesDisponibles)
                            {
                                <td class="@(p.Id == datos.Plan.Id ? "plan-actual" : null)">@(p.Modulos.Contains(m.Codigo) ? "✓" : "—")</td>
                            }
                        </tr>
                    }
                    @if (datos.MercadoPagoHabilitado && Sesion.EsAdministrador)
                    {
                        <tr>
                            <th></th>
                            @foreach (var p in datos.PlanesDisponibles)
                            {
                                var esElDebitoActual = p.Id == datos.Plan.Id && datos.DebitoAutomatico == EstadoDebitoAutomatico.Activo;
                                <td class="@(p.Id == datos.Plan.Id ? "plan-actual" : null)">
                                    @if (esElDebitoActual)
                                    {
                                        <span class="ayuda">Suscripto</span>
                                    }
                                    else if (p.PrecioMensual > 0)
                                    {
                                        <button class="btn-primario" disabled="@(procesando || !EmailValido)" @onclick="() => PagarAsync(p)"
                                                title="@(EmailValido ? null : "Ingresá el email de tu cuenta de Mercado Pago")">
                                            @(procesando && planPagando == p.Id ? "Redirigiendo…" : "Suscribirme")
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="tarjeta">
        <h2>Pagos</h2>
        @if (datos.Pagos.Count == 0)
        {
            <p>Todavía no hay pagos registrados.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Fecha</th><th>Plan</th><th>Meses</th><th class="num">Monto</th><th>Cubre hasta</th><th>Medio</th></tr></thead>
                <tbody>
                    @foreach (var p in datos.Pagos)
                    {
                        <tr>
                            <td>@p.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>@p.Plan</td>
                            <td>@p.Meses</td>
                            <td class="num">@TextosSuscripcion.Pesos(p.Monto)</td>
                            <td>@p.PeriodoHastaUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>@(p.Origen == OrigenPagoSuscripcion.MercadoPago ? "Mercado Pago" : "Registrado por HS Tech")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private MiSuscripcionDto? datos;
    private string? error;
    private string emailPagador = string.Empty;
    private bool procesando;
    private bool confirmandoCancelacion;
    private bool volvioDeMercadoPago;
    private Guid? planPagando;

    private bool EmailValido => System.Text.RegularExpressions.Regex.IsMatch(emailPagador.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$");

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/");
            return;
        }
        // Mercado Pago vuelve a esta página con ?preapproval_id=... después de autorizar
        volvioDeMercadoPago = new Uri(Navegacion.Uri).Query.Contains("preapproval_id", StringComparison.OrdinalIgnoreCase);
        await RecargarAsync();
    }

    private async Task PagarAsync(PlanDto plan)
    {
        error = null;
        procesando = true;
        planPagando = plan.Id;
        try
        {
            var inicio = await Api.IniciarPagoMercadoPagoAsync(plan.Id, emailPagador.Trim());
            Navegacion.NavigateTo(inicio.UrlPago, forceLoad: true); // sale de la app hacia Mercado Pago
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            procesando = false;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
            procesando = false;
        }
    }

    private async Task CancelarDebitoAsync()
    {
        error = null;
        procesando = true;
        try
        {
            await Api.CancelarDebitoAutomaticoAsync();
            confirmandoCancelacion = false;
            await RecargarAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task RecargarAsync()
    {
        try
        {
            datos = await Api.ObtenerMiSuscripcionAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            if (!Sesion.EstaAutenticado) Navegacion.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
    }

    private static string Vencimiento(SuscripcionResumenDto r) => r.Estado switch
    {
        EstadoSuscripcion.Prueba => $"La prueba termina el {Fecha(r.VenceUtc)} ({TextosSuscripcion.Dias(r.DiasRestantes)}).",
        EstadoSuscripcion.Activa => $"Pagada hasta el {Fecha(r.VenceUtc)}.",
        EstadoSuscripcion.EnGracia => $"Venció el {Fecha(r.VenceUtc)}. Pasa a solo lectura el {Fecha(r.FinGraciaUtc)}.",
        _ => $"Venció el {Fecha(r.VenceUtc)}. Regularizá el pago para volver a operar."
    };

    private static string Fecha(DateTime? utc) => utc?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—";
}
