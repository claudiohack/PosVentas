@page "/auditoria"
@inject PosVentasApi Api
@inject SesionService Sesion
@inject NavigationManager Navegacion

<PageTitle>Auditoría · PosVentas</PageTitle>

<h1>Auditoría</h1>

@if (!Sesion.Tiene(Permisos.AuditoriaConsultar))
{
    <section class="tarjeta"><p>Tu rol no tiene permiso para consultar la auditoría.</p></section>
}
else
{
    <form class="fila-form tarjeta filtros-auditoria" @onsubmit="() => CargarAsync(1)">
        <label>Desde <input type="date" @bind="desde" /></label>
        <label>Hasta <input type="date" @bind="hasta" /></label>
        <label>
            Sobre
            <select @bind="entidad">
                <option value="">Todo</option>
                <option value="Rol">Roles</option>
                <option value="Usuario">Usuarios</option>
                <option value="Venta">Ventas anuladas</option>
                <option value="CajaSesion">Caja</option>
                <option value="Producto">Productos</option>
                <option value="Comercio">Facturación</option>
            </select>
        </label>
        <button type="submit" class="btn-buscar" disabled="@cargando">Filtrar</button>
    </form>

    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }

    <section class="tarjeta">
        @if (pagina is null)
        {
            <p>Cargando…</p>
        }
        else if (pagina.Registros.Count == 0)
        {
            <p>No hay registros para el filtro elegido.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Detalle</th></tr></thead>
                <tbody>
                    @foreach (var r in pagina.Registros)
                    {
                        <tr>
                            <td class="nowrap">@r.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(r.Usuario ?? "Sistema")</td>
                            <td><span class="badge accion-@r.Entidad.ToLowerInvariant()">@Accion(r.Accion)</span></td>
                            <td class="detalle-auditoria">@r.Detalle</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="paginador">
                <span>@pagina.Total registro@(pagina.Total == 1 ? "" : "s")</span>
                <button class="btn-secundario" disabled="@(pagina.Pagina <= 1 || cargando)" @onclick="() => CargarAsync(pagina.Pagina - 1)">Anterior</button>
                <span>Página @pagina.Pagina de @TotalPaginas</span>
                <button class="btn-secundario" disabled="@(pagina.Pagina >= TotalPaginas || cargando)" @onclick="() => CargarAsync(pagina.Pagina + 1)">Siguiente</button>
            </div>
        }
    </section>
}

@code {
    private PaginaAuditoriaDto? pagina;
    private DateOnly? desde;
    private DateOnly? hasta;
    private string entidad = string.Empty;
    private string? error;
    private bool cargando;

    private int TotalPaginas => pagina is null ? 1 : Math.Max(1, (int)Math.Ceiling(pagina.Total / (double)pagina.TamanioPagina));

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/");
            return;
        }
        if (Sesion.Tiene(Permisos.AuditoriaConsultar))
            await CargarAsync(1);
    }

    private async Task CargarAsync(int numero)
    {
        error = null;
        cargando = true;
        try
        {
            pagina = await Api.ObtenerAuditoriaAsync(desde, hasta, entidad, numero);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            if (!Sesion.EstaAutenticado) Navegacion.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }

    private static string Accion(string codigo) => codigo switch
    {
        "rol.creado" => "Rol creado",
        "rol.modificado" => "Rol modificado",
        "rol.eliminado" => "Rol eliminado",
        "usuario.creado" => "Usuario creado",
        "usuario.modificado" => "Usuario modificado",
        "usuario.rol-cambiado" => "Cambio de rol",
        "usuario.password-reseteada" => "Contraseña reseteada",
        "usuario.activado" => "Usuario activado",
        "usuario.desactivado" => "Usuario dado de baja",
        "venta.anulada" => "Venta anulada",
        "caja.abierta" => "Caja abierta",
        "caja.cerrada" => "Caja cerrada",
        "producto.creado" => "Producto creado",
        "producto.precio-modificado" => "Cambio de precio",
        "producto.stock-ingresado" => "Ingreso de stock",
        "producto.activado" => "Producto reactivado",
        "producto.desactivado" => "Producto dado de baja",
        "productos.importados" => "Importación de productos",
        "facturacion.datos-modificados" => "Datos fiscales",
        "facturacion.certificado-cargado" => "Certificado ARCA",
        _ => codigo
    };
}
